SENSOR temp AT A0 ANALOG UNIT C RANGE -40..125;
RULE n0: WHEN temp > 0 THEN NOTIFY "t0";
RULE n1: WHEN temp > 10 THEN NOTIFY "t1";
RULE n2: WHEN temp > 20 THEN NOTIFY "t2";
RULE n3: WHEN temp > 30 THEN NOTIFY "t3";
RULE n4: WHEN temp > 40 THEN NOTIFY "t4";
RULE n5: WHEN temp > 50 THEN NOTIFY "t5";
RULE n6: WHEN temp > 60 THEN NOTIFY "t6";
RULE n7: WHEN temp > 70 THEN NOTIFY "t7";
RULE n8: WHEN temp > 80 THEN NOTIFY "t8";
RULE n9: WHEN temp > 90 THEN NOTIFY "t9";
RULE n10: WHEN temp > 100 THEN NOTIFY "t10";
