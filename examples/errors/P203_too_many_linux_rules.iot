SENSOR temp AT A0 ANALOG UNIT C RANGE -40..125;
ACTUATOR a0 AT D2;
ACTUATOR a1 AT D3;
ACTUATOR a2 AT D4;
ACTUATOR a3 AT D5;
ACTUATOR a4 AT D6;
ACTUATOR a5 AT D7;
ACTUATOR a6 AT D8;
ACTUATOR a7 AT D9;
ACTUATOR a8 AT D10;
ACTUATOR a9 AT D11;
ACTUATOR a10 AT D12;
ACTUATOR a11 AT D13;
ACTUATOR a12 AT A2;
ACTUATOR a13 AT A3;
ACTUATOR a14 AT A4;
ACTUATOR a15 AT A5;
ACTUATOR a16 AT LED3R;
RULE on0: WHEN avg(temp, 10s) > 30 THEN a0 ON;
RULE off0: WHEN avg(temp, 10s) < 0 THEN a0 OFF;
RULE on1: WHEN avg(temp, 10s) > 31 THEN a1 ON;
RULE off1: WHEN avg(temp, 10s) < 1 THEN a1 OFF;
RULE on2: WHEN avg(temp, 10s) > 32 THEN a2 ON;
RULE off2: WHEN avg(temp, 10s) < 2 THEN a2 OFF;
RULE on3: WHEN avg(temp, 10s) > 33 THEN a3 ON;
RULE off3: WHEN avg(temp, 10s) < 3 THEN a3 OFF;
RULE on4: WHEN avg(temp, 10s) > 34 THEN a4 ON;
RULE off4: WHEN avg(temp, 10s) < 4 THEN a4 OFF;
RULE on5: WHEN avg(temp, 10s) > 35 THEN a5 ON;
RULE off5: WHEN avg(temp, 10s) < 5 THEN a5 OFF;
RULE on6: WHEN avg(temp, 10s) > 36 THEN a6 ON;
RULE off6: WHEN avg(temp, 10s) < 6 THEN a6 OFF;
RULE on7: WHEN avg(temp, 10s) > 37 THEN a7 ON;
RULE off7: WHEN avg(temp, 10s) < 7 THEN a7 OFF;
RULE on8: WHEN avg(temp, 10s) > 38 THEN a8 ON;
RULE off8: WHEN avg(temp, 10s) < 8 THEN a8 OFF;
RULE on9: WHEN avg(temp, 10s) > 39 THEN a9 ON;
RULE off9: WHEN avg(temp, 10s) < 9 THEN a9 OFF;
RULE on10: WHEN avg(temp, 10s) > 40 THEN a10 ON;
RULE off10: WHEN avg(temp, 10s) < 10 THEN a10 OFF;
RULE on11: WHEN avg(temp, 10s) > 41 THEN a11 ON;
RULE off11: WHEN avg(temp, 10s) < 11 THEN a11 OFF;
RULE on12: WHEN avg(temp, 10s) > 42 THEN a12 ON;
RULE off12: WHEN avg(temp, 10s) < 12 THEN a12 OFF;
RULE on13: WHEN avg(temp, 10s) > 43 THEN a13 ON;
RULE off13: WHEN avg(temp, 10s) < 13 THEN a13 OFF;
RULE on14: WHEN avg(temp, 10s) > 44 THEN a14 ON;
RULE off14: WHEN avg(temp, 10s) < 14 THEN a14 OFF;
RULE on15: WHEN avg(temp, 10s) > 45 THEN a15 ON;
RULE off15: WHEN avg(temp, 10s) < 15 THEN a15 OFF;
RULE on16: WHEN avg(temp, 10s) > 46 THEN a16 ON;
RULE off16: WHEN avg(temp, 10s) < 16 THEN a16 OFF;
