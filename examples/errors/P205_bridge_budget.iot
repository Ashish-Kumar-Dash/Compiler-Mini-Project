// options: --sample-ms 10
SENSOR s0 AT A0 ANALOG UNIT C RANGE 0..100;
SENSOR s1 AT A1 ANALOG UNIT C RANGE 0..100;
SENSOR s2 AT A2 ANALOG UNIT C RANGE 0..100;
SENSOR s3 AT A3 ANALOG UNIT C RANGE 0..100;
SENSOR s4 AT A4 ANALOG UNIT C RANGE 0..100;
SENSOR s5 AT A5 ANALOG UNIT C RANGE 0..100;
SENSOR d0 AT D2 DIGITAL;
SENSOR d1 AT D3 DIGITAL;
RULE n0: WHEN s0 > 50 THEN NOTIFY "s0";
RULE n1: WHEN s1 > 50 THEN NOTIFY "s1";
RULE n2: WHEN s2 > 50 THEN NOTIFY "s2";
RULE n3: WHEN s3 > 50 THEN NOTIFY "s3";
RULE n4: WHEN s4 > 50 THEN NOTIFY "s4";
RULE n5: WHEN s5 > 50 THEN NOTIFY "s5";
RULE m0: WHEN d0 == 1 THEN NOTIFY "d0";
RULE m1: WHEN d1 == 1 THEN NOTIFY "d1";
