// expect: W107 W110
SENSOR temp AT A0 ANALOG UNIT C RANGE -40..125;
ACTUATOR fan AT D7;
ACTUATOR heater AT D8;
RULE cool: WHEN avg(temp, 10s) > 35 THEN fan ON;
RULE uncool: WHEN avg(temp, 10s) < 30 THEN fan OFF;
RULE unwarm: WHEN avg(temp, 10s) > 15 THEN heater OFF;
SAFETY NEVER heater ON AND fan ON;
SAFETY ENSURE fan ON WHEN temp > 50;
FAILSAFE heater ON;
