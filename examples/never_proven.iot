// A NEVER pair the compiler proves: every rule that turns one side ON is covered by a rule
// that turns the other side OFF over a superset of its condition.
SENSOR   temp   AT A0 ANALOG UNIT C RANGE -40..125;
ACTUATOR fan    AT D7;
ACTUATOR heater AT D8;

RULE cool:   WHEN temp > 35 THEN fan ON;
RULE uncool: WHEN temp < 30 THEN fan OFF;
RULE warm:   WHEN temp < 10 THEN heater ON;
RULE unwarm: WHEN temp > 15 THEN heater OFF;

SAFETY NEVER heater ON AND fan ON;
